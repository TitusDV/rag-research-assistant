# Model that writes the test questions (and later answers questions).
# "llama3" runs locally through Ollama (run `ollama pull llama3` first).
# A name starting with "gpt", such as "gpt-6-luna", uses OpenAI and needs OPENAI_API_KEY.
MODEL=llama3
OPENAI_API_KEY=

# Optional: a different model for the automatic review (scripts/auto_review.py). Defaults to MODEL.
JUDGE_MODEL=

# Optional: questions the web app allows per day across all visitors. Defaults to 100.
DAILY_LIMIT=
